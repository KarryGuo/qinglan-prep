# Turso（libSQL）数据库。CLI 直连时可写成带 token 的完整串：
# libsql://<db-name>.turso.io?authToken=<token>
TURSO_DATABASE_URL=libsql://qinglan-prep.turso.io
TURSO_AUTH_TOKEN=

# OpenAI 兼容的模型服务
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 视觉模型（作业照片识别成绩），需与 LLM_API_KEY 同服务且支持 image_url 输入
# 千问示例：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1 时用 qwen-vl-plus
VLM_MODEL=qwen-vl-plus

# true 时免登录，全部数据归属种子教师
DEMO_MODE=true

# 会话签名密钥：独立于 LLM_API_KEY，生产环境必须配置（≥16 位）
# 生成方式：openssl rand -hex 32
# 未配置时：开发环境回退固定开发密钥并告警；生产环境会话功能拒绝运行
SESSION_SECRET=
